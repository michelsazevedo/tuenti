# Copy to .env and adjust as needed: `cp .env.example .env`
# Values below match the ports docker-compose exposes on localhost.

# Postgres
POSTGRES_HOST=localhost:5432
POSTGRES_USER=tuenti
POSTGRES_PASSWORD=tuentipwd
POSTGRES_DB=tuenti

# App
ENV_APP=development

# Redis
REDIS_HOST=localhost:6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092

# Observability (Jaeger OTLP endpoint)
OTLP_ENDPOINT=localhost:4318

# Public URLs embedded in outbound emails
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
EMAIL_CONFIRMATION_BASE_URL=http://localhost:3000/confirm-email
INVITATION_BASE_URL=http://localhost:3000/invitations/accept
